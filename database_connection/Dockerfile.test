# syntax=docker/dockerfile:1.7
FROM rust:latest

WORKDIR /usr/src/app

# Install docker client CLI to allow stopping containers dynamically
RUN apt-get update && apt-get install -y docker.io

# Copy the entire workspace to build the tests
COPY . .

# Pre-compile the testing binary with cached deps to speed up rebuilds
RUN --mount=type=cache,target=/usr/local/cargo/registry \
	--mount=type=cache,target=/usr/local/cargo/git \
	--mount=type=cache,target=/usr/src/app/target \
    cargo test -p database --test database_test --no-run && \
    find target/debug/deps -type f -executable -name "database_test*" -exec cp {} /usr/local/bin/run_tests \;

# Run the pre-compiled database test binary
CMD sleep 3 && /usr/local/bin/run_tests --nocapture