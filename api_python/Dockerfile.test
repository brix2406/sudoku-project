FROM python:3.11-slim

# Set the working directory to the root of our "monorepo" inside the container
WORKDIR /usr/src/app

# 1. Copy just the requirements first (to keep Docker builds fast)
COPY api_python/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# Copy the API source and tests
COPY api_python/ ./api_python/

# 3. Move into the API folder, exactly like you do in your terminal before running tests
ENV PYTHONPATH=/usr/src/app/api_python/src
WORKDIR /usr/src/app/api_python

# Run the tests
CMD ["pytest"]