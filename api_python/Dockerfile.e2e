FROM python:3.11-slim

WORKDIR /usr/src/app

COPY api_python/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY api_python/ ./api_python/

ENV PYTHONPATH=/usr/src/app/api_python/src
WORKDIR /usr/src/app/api_python

CMD ["pytest", "tests/", "-m", "e2e", "-v", "--ignore=tests/test_worker_nats.py"]
